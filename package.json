{
  "name": "cardi-golf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Platform for running amateur golf tournaments among friends: live scoring, side games, Calcutta auction, money and settlement.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "bash scripts/preflight.sh",
    "quality": "node scripts/quality/status.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "node e2e/smoke.mjs",
    "e2e:profile": "node e2e/profile.mjs",
    "simulate": "node scripts/simulate.mjs",
    "rehearse:auction": "node scripts/rehearse-auction.mjs",
    "shots": "node scripts/design-shots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/fraunces": "^5.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.3",
    "dexie": "^4.0.11",
    "html-to-image": "^1.11.13",
    "motion": "^12.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "recharts": "^3.2.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
