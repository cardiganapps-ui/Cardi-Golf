{
  "name": "cardi-golf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Platform for running amateur golf tournaments among friends: live scoring, side games, Calcutta auction, money and settlement.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-precache.mjs dist && node scripts/check-bundle.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "bench:engine": "POLO_ENGINE_BUDGET=1 vitest run src/engine/engine.budget.test.ts",
    "preflight": "bash scripts/preflight.sh",
    "quality": "node scripts/quality/status.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e:profile": "node e2e/profile.mjs",
    "simulate": "node scripts/simulate.mjs",
    "rehearse:auction": "node scripts/rehearse-auction.mjs",
    "shots": "node scripts/design-shots.mjs",
    "build:fixtures": "VITE_DESIGN_ROUTES=1 vite build --outDir dist-fixtures",
    "e2e:fixtures": "playwright test",
    "build:stack": "vite build --outDir dist-stack",
    "e2e:stack": "playwright test -c playwright.stack.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/fraunces": "^5.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "aws4fetch": "^1.0.20",
    "canvas-confetti": "^1.9.3",
    "dexie": "^4.0.11",
    "html-to-image": "^1.11.13",
    "motion": "^12.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^16.0.1",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
