  "cases": [
    {
      "name": "scores: a phone saves its own player's new hole",
      "as": "uid-p1",
      "request": {
        "method": "POST",
        "table": "scores",
        "onConflict": "round_id,player_id,hole",
        "prefer": "resolution=merge-duplicates",
        "body": {
          "round_id": "r1",
          "player_id": "p1",
          "hole": 5,
          "strokes": 5,
          "putts": 2,
          "picked_up": false,
          "entered_by": "p1",
          "client_ts": "2027-04-09T12:00:00.000Z"
        }
      },
      "expect": {
        "status": 201
      },
      "then": [
        {
          "table": "scores",
          "where": {
            "round_id": "r1",
            "player_id": "p1",
            "hole": 5
          },
          "rows": [
            {
              "strokes": 5,
              "entered_by": "p1",
              "disputed": false
            }
          ]
        }
      ]
    },
