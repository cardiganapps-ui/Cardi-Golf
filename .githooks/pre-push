#!/usr/bin/env bash
# Git-level guard (any client, not only Claude's Bash tool):
#   1. never push to main (QA-10): main deploys to production, and it changes
#      only by merging a green PR;
#   2. run the same preflight CI runs and refuse the push when it fails.
# Wired by `git config core.hooksPath .githooks`, which the Claude session
# runs at start (.claude/settings.json, SessionStart).
set -uo pipefail
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push blocked: never push to main. Push a claude/<topic> branch and open a PR." >&2
    exit 1
  fi
done
root="$(git rev-parse --show-toplevel)"
# Git exports GIT_DIR and friends to its hooks. Left in place, every git call
# the preflight makes (the guard tests build throwaway repos) acts on this
# repository instead: commits landed on the branch being pushed and
# `git init` marked the checkout bare. Preflight runs from the root, so it
# finds the repository without them.
unset $(git rev-parse --local-env-vars)
cd "$root" || exit 1
log="${TMPDIR:-/tmp}/polo-prepush.log"
if bash "$root/scripts/preflight.sh" > "$log" 2>&1; then
  exit 0
fi
echo "Push blocked: preflight failed (full log: $log)" >&2
grep -E '^\s*✗|error|Error|FAIL' "$log" | head -40 >&2
exit 1
