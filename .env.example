# Browser-safe (Vite inlines VITE_* into the bundle by design)
VITE_SUPABASE_URL=https://gmohwledjejlhcwqjnhd.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_AfdMuv4UnxfuskCeC-JCJw_iuEJB6sK

# Server-only. NEVER prefix with VITE_, never commit real values.
# Live in the Claude Code environment secrets and in Vercel (if a serverless route ever needs them).
# Supabase (scripts/db.mjs, rls-test, seed, simulator; api/backup-cron on Vercel)
# SUPABASE_PAT=
# SUPABASE_PROJECT_REF=gmohwledjejlhcwqjnhd
# SUPABASE_SECRET_KEY=
# Vercel REST API (env vars, project settings)
# VERCEL_TOKEN=
# Course routes (Vercel, Production + Preview)
# GOLFCOURSE_API_KEY=
# OPENGOLF_API_KEY=
# ANTHROPIC_API_KEY=
# Nightly backup (Vercel, Production only). SUPABASE_URL is the project URL, read by api/backup-cron.ts.
# SUPABASE_URL=https://gmohwledjejlhcwqjnhd.supabase.co
# CRON_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET=cardi-golf-backups
# Design shots (scripts/design-organizer.mjs writes these)
# DESIGN_ORG_EMAIL=
# DESIGN_ORG_PASSWORD=
# Web push (Vercel, Production + Preview; the secret and the dispatch URL also live in Supabase Vault).
# Rotate both places together, then run scripts/push-check.mjs.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:golf@cardigan.mx
# PUSH_DISPATCH_SECRET=
# Browser copy of the public VAPID key (safe to ship).
# VITE_VAPID_PUBLIC_KEY=
# Dev-only routes (/design, /fixture, /t/_/<fixture>) in a production build: set on Vercel Preview only
# VITE_DESIGN_ROUTES=1
# Script knobs (local runs only): the app's URL for screenshots, a Chromium binary, skip the
# real-device part of a live test.
# BASE=http://localhost:4173
# CHROMIUM=
# SKIP_REAL=1
# End-to-end runs (e2e/*.mjs): which Ensayo player the smoke enters as, its PIN (never committed),
# the tournament slug, a per-step timeout in ms, and E2E_RELAY=1 to send Supabase calls through
# Node's fetch when the browser cannot use the sandbox's proxy.
# E2E_SLUG=
# E2E_PLAYER=
# E2E_PIN=
# E2E_TIMEOUT=
# E2E_RELAY=
