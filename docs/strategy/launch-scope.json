    "torneo": {
      "launch": true,
      "what": "Entrar, En vivo, Tarjeta, Juegos, Dinero, Más, la tele, la Ceremonia, las tarjetas de papel y el enlace para ver: lo que usan los jugadores del viaje."
    },
    "comite": {
      "launch": true,
      "what": "La consola del Comité: torneo, jugadores, campos, rondas, grupos, hándicaps, juegos, tarjetas, Calcutta, parejas, equipos, historial y datos."
    },
