{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "NotebookEdit(*)",
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)",
      "Edit(//home/user/**)",
      "Write(//home/user/**)",
      "NotebookEdit(//home/user/**)",
      "Edit(//tmp/**)",
      "Write(//tmp/**)",
      "Edit(//root/.claude/**)",
      "Write(//root/.claude/**)",
      "WebFetch",
      "WebSearch",
      "mcp__Supabase",
      "mcp__Vercel",
      "mcp__github",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Docs",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a",
      "Agent",
      "SendMessage",
      "ListAgents",
      "Skill",
      "ToolSearch",
      "Monitor",
      "ReadNotifications",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "TaskOutput",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "SendUserFile",
      "ReportFindings",
      "EnterWorktree",
      "ExitWorktree",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "ask": [
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_credits_endpoint",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_domains",
      "mcp__Vercel__buy_pro",
      "mcp__Vercel__buy_single_domain",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Vercel__pause_project"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)"
    ],
    "additionalDirectories": [
      "/home/user",
      "/tmp",
      "/root/.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/prepush-guard.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
