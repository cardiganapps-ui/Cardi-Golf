{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "NotebookEdit(*)",
      "Read(//**)",
      "Glob(//**)",
      "Grep(//**)",
      "Edit(//home/user/**)",
      "Write(//home/user/**)",
      "NotebookEdit(//home/user/**)",
      "Edit(//tmp/**)",
      "Write(//tmp/**)",
      "Edit(//root/.claude/**)",
      "Write(//root/.claude/**)",
      "WebFetch",
      "WebSearch",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "mcp__Supabase",
      "mcp__Supabase__*",
      "mcp__Vercel",
      "mcp__Vercel__*",
      "mcp__github",
      "mcp__github__*",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__pull_request_read",
      "mcp__github__pull_request_review_write",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__resolve_review_thread",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__github__delete_file",
      "mcp__github__actions_run_trigger",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Code_Remote__*",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__get_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__add_repo",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__register_repo_root",
      "mcp__Claude_Code_Remote__read_documentation",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__set_session_title",
      "mcp__Claude_Code_Remote__set_session_tags",
      "mcp__Claude_Code_Remote__watch_url",
      "mcp__Claude_Code_Remote__unwatch_url",
      "mcp__Claude_Docs",
      "mcp__Claude_Docs__*",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__*",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "PushNotification",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "Workflow",
      "ListConnectors",
      "ListPlugins",
      "ListSkills",
      "SearchSkills",
      "SuggestSkills",
      "Agent",
      "SendMessage",
      "ListAgents",
      "Skill",
      "ToolSearch",
      "Monitor",
      "ReadNotifications",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "TaskOutput",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "SendUserFile",
      "ReportFindings",
      "EnterWorktree",
      "ExitWorktree",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "ask": [
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_credits_endpoint",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_domains",
      "mcp__Vercel__buy_pro",
      "mcp__Vercel__buy_single_domain",
      "mcp__Vercel__create_or_transfer_domain",
      "mcp__Vercel__pause_project"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)"
    ],
    "additionalDirectories": [
      "/home/user",
      "/tmp",
      "/root/.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/prepush-guard.sh\"",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/mcp-main-guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
